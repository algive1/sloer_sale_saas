# Saleor API URL (required) - keep the trailing slash
NEXT_PUBLIC_SALEOR_API_URL=https://your-instance.saleor.cloud/graphql/

# Optional Paper handshake label for /api/cache-info identity (production|staging|preview|development).
# Leave unset on Vercel — VERCEL_ENV / NODE_ENV fill this in. Set only when those lie:
# e.g. a staging host with NODE_ENV=production, or any non-Vercel deploy that isn't prod.
# PAPER_STOREFRONT_ENVIRONMENT=staging

# Storefront URL - set on production for correct canonical URLs, OG images, and redirect allowlist
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Mobile dev via ngrok / LAN — hostnames only (no https://), comma-separated.
# Required when a real device loads the dev server through a tunnel; restart pnpm dev after change.
# ALLOWED_DEV_ORIGINS=servilely-quare-polly.ngrok-free.dev

# Checkout-only deploy (optional) — absolute checkout links from storefront and redirect allowlist
# NEXT_PUBLIC_CHECKOUT_URL=https://checkout.example.com

# Extra allowed redirect origins (optional) — comma-separated origins
# 
# Must include the protocol + domain + optional port, for example:
#   - https://example.com
#   - http://localhost:3000
#   - http://127.0.0.1:3000
#
# See ./docs/configuration/allowed-origins.md for more information
#
# ALLOWED_EXTRA_ORIGINS=https://preview.example.com,https://checkout-preview.example.com

# Channel slug (required) - fallback when STOREFRONT_CHANNELS is not set
# The root "/" redirects to this channel (e.g., "/default-channel")
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# Storefront channel allowlist (recommended for multi-channel) — comma-separated slugs
# Only these channels get routes, cache invalidation, and footer selector entries.
# STOREFRONT_CHANNELS=us,uk,eu

# Storefront locale allowlist — comma-separated URL slugs (e.g. en,pl,de,fr,fi,nb,ja,ko).
# Must be NEXT_PUBLIC_* so client components (checkout logo, locale links) match SSR.
# NEXT_PUBLIC_STOREFRONT_LOCALES=en,pl,de,fr,fi,nb,ja,ko
# Also drives hreflang x-default (same target as root redirect / invalid-locale fallback).
# NEXT_PUBLIC_DEFAULT_LOCALE=en
# Optional hard locale↔market matrix: invalid pairs 404; language switch jumps to the paired
# channel; hreflang keys become region-aware (ja-JP). When unset, any locale × channel is OK.
# NEXT_PUBLIC_STOREFRONT_LOCALE_CHANNELS=en:default-channel,ja:japan,pl:channel-pln

# Storefront marketing copy — default is saleor (Saleor Models). Opt out with code.
CONTENT_PROVIDER=saleor
# CONTENT_PROVIDER=code

# Optional typography theme examples — default is Geist-only (Direction C).
# See config/themes/README.md and config/themes/typography-editorial.env.example
# Or: pnpm run dev:theme-editorial
# NEXT_PUBLIC_TYPOGRAPHY_THEME=editorial

# App token (optional) — channel discovery and guest /order/find (needs MANAGE_ORDERS).
# SALEOR_APP_TOKEN=

# Configurator (dev/staging only) — NOT loaded by Next.js. Copy .env.configurator.local.example
# SALEOR_CONFIGURATOR_TOKEN lives in .env.configurator.local — see config/saleor/README.md

# Opt-in: discover ALL active Saleor channels from API (not recommended when Saleor has many channels).
# Prefer STOREFRONT_CHANNELS instead. Requires SALEOR_APP_TOKEN.
# STOREFRONT_DISCOVER_CHANNELS=true

# Cache invalidation — use ≥32 character random strings in production
# Manual revalidation: GET /api/cache-info and GET /api/revalidate (Authorization: Bearer header)
# REVALIDATE_SECRET=
# Guest order-view HMAC (falls back to REVALIDATE_SECRET). Required in production if REVALIDATE_SECRET is unset.
# ORDER_VIEW_SECRET=
# Saleor webhook HMAC for POST /api/revalidate (Dashboard → Configuration → Webhooks)
# SALEOR_WEBHOOK_SECRET=

# Checkout — Dummy Payment (local/staging test orders)
# Enabled automatically in development. Set to true on cloud/staging to allow dummy checkout.
# ALLOW_DUMMY_PAYMENT=true
# NEXT_PUBLIC_ALLOW_DUMMY_PAYMENT=true

# Checkout — Stripe Elements (Saleor Stripe app)
# Required on cloud/staging (NODE_ENV=production). Auto-enabled in local development.
# Publishable keys come from Saleor paymentGatewayInitialize — configure Stripe in Saleor Dashboard.
# NEXT_PUBLIC_ENABLE_STRIPE_PAYMENTS=true
# ENABLE_STRIPE_PAYMENTS=true
# Express Checkout wallets (Apple Pay, Google Pay, Link) on payment step — on when Stripe is enabled.
# NEXT_PUBLIC_ENABLE_STRIPE_EXPRESS_CHECKOUT=false

# Checkout contact step — "Email me with news and offers" (on by default; persisted as checkout metadata).
# NEXT_PUBLIC_ENABLE_CHECKOUT_MARKETING_OPT_IN=false


# ---------------------------------------------------------------------------
# SEO / Google Merchant
# ---------------------------------------------------------------------------
# Dynamic sitemap is available at /sitemap.xml and advertised from /robots.txt.
# Google Merchant XML feed is disabled by default; enable only after real catalog data,
# identifiers, shipping/tax settings, policy pages, and production domain are ready.
# Feed URL: /merchant/google.xml?channel=us&locale=en
# GOOGLE_MERCHANT_FEED_ENABLED=true
# Optional comma-separated SKU prefixes to suppress non-production items from the feed.
# GOOGLE_MERCHANT_EXCLUDE_SKU_PREFIXES=DEMO-

# ---------------------------------------------------------------------------
# Cost controls (Vercel)
# ---------------------------------------------------------------------------
# Paper's defaults are tuned for a production catalogue. Each knob below trades
# money against freshness — see skills/saleor-paper-storefront/rules/data-caching.md
# § Cost controls and rules/ui-images.md for the reasoning.

# Which pipeline serves catalog images. Default `saleor`: PLP cards and the PDP gallery
# render a plain <img srcset> against Saleor's CloudFront-backed thumbnails, so those
# images never touch /_next/image and are never billed as transformations. Set to
# `vercel` to route everything back through next/image without a code change — the
# escape hatch if your Saleor deployment does not front media with a CDN.
# NEXT_PUBLIC_PAPER_IMAGE_PIPELINE=saleor

# Extra hostnames /_next/image is allowed to optimize (comma-separated, no scheme).
# Saleor Cloud hosts and the NEXT_PUBLIC_SALEOR_API_URL host are always allowed.
# Anything listed here can be optimized at your expense — keep it tight.
# IMAGE_ALLOWED_HOSTS=cdn.example.com,assets.example.com

# How long Vercel keeps an optimized image before re-optimizing it (seconds).
# Default 2678400 (31 days). Saleor thumbnail URLs are stable, so this is nearly free —
# but replacing an image *in place* in Saleor reuses the URL, so the old bytes serve
# until this expires. Lower it if the catalogue is re-shot often.
# NEXT_IMAGE_MIN_CACHE_TTL=2678400

# Speed Insights sampling (0–1). Default 0.01: Vercel bills ~3–6 data points per hard
# navigation, and unsampled collection at high traffic can cost more than the rest of
# the storefront infrastructure. 1% is enough for a weekly P75 at scale; on a
# low-traffic / demo project the daily RES line becomes a random walk — raise this
# to 1 only for a short investigation, then set it back.
# NEXT_PUBLIC_SPEED_INSIGHTS_SAMPLE_RATE=0.01

# Vercel Web Analytics (cookieless page views — the human page-view denominator).
# Default: on when building on Vercel (VERCEL=1), off elsewhere. No sampling knob exists;
# it is billed per event (~$3 per 100k on Pro), so the lever is on/off. Also enable Web
# Analytics in the Vercel project (Analytics tab) or the script 404s on every page.
# URLs are redacted before send (checkout id, order token, search terms, Stripe secrets).
# NEXT_PUBLIC_VERCEL_WEB_ANALYTICS=1

# Analytics consent. required (default) shows the built-in banner and waits for an explicit choice.
# implied allows analytics storage immediately, but advertising still requires an explicit grant.
# NEXT_PUBLIC_ANALYTICS_CONSENT_MODE=required

# Google Analytics 4. Client events use gtag; GA4_API_SECRET enables server-side Measurement
# Protocol for successful add-to-cart / purchase events. Never expose GA4_API_SECRET to the browser.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# GA4_API_SECRET=

# Google Ads purchase conversion + enhanced conversions (email is sent only after explicit consent).
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-123456789
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=AbCdEfGhIjKlMnOp

# Meta Pixel + Conversions API. The access token is server-only.
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345
# META_CONVERSIONS_API_TOKEN=

# TikTok Pixel + Events API. The access token is server-only.
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=CXXXXXXXXXXXXXXXXX
# TIKTOK_EVENTS_API_ACCESS_TOKEN=

# Bust `listing:all:{channel}` on every listing-affecting product webhook.
# Default on. Set to 0 for high-churn catalogs: selling one unique SKU
# should not regenerate the all-products grid. Category and collection
# shards still bust; the all-products page then relies on the 1 h catalog backstop.
# PAPER_BUST_LISTING_ALL_ON_PRODUCT_EVENT=0

# Forced delay between Saleor GraphQL requests (ms). Defaults to 200 during `next build`
# (where generateStaticParams can trip Saleor's rate limiter) and 0 at runtime, where it
# would only add latency you pay for. Raise it if Saleor rate-limits your live traffic.
# SALEOR_MIN_REQUEST_DELAY_MS=0

# Discovering channels queries Saleor during generateStaticParams and then prerenders
# every locale x channel pair, so build minutes and prerendered output grow with the
# product of both. An explicit STOREFRONT_CHANNELS allowlist is the cheaper default;
# only opt in when the channel list genuinely changes without a deploy.
# STOREFRONT_DISCOVER_CHANNELS=true

# Max concurrent Saleor GraphQL requests per instance (default 3).
# SALEOR_MAX_CONCURRENT_REQUESTS=3


# ---------------------------------------------------------------------------
# First-party marketing analytics + cloud wishlist (optional, server-only)
# ---------------------------------------------------------------------------
# libSQL/Turso endpoint. When omitted, storefront shopping and local wishlist still work;
# first-party event history, /ops/analytics data, and cross-device wishlist sync are disabled.
# ANALYTICS_LIBSQL_URL=libsql://your-database.turso.io
# ANALYTICS_LIBSQL_AUTH_TOKEN=
# Legacy Basic authentication for all /ops/* pages (username: analytics).
# ANALYTICS_DASHBOARD_SECRET=
# Optional server-only operator accounts; REPLACES legacy login when set.
# Roles: platform_admin (all /ops) or brand_analyst (read-only assigned site pages).
# Use 32+ character ASCII secrets. See docs/ops-operator-permissions.md.
# OPS_OPERATORS_JSON=

# ---------------------------------------------------------------------------
# Operations: manual + automated unpaid-order reminders (disabled by default)
# ---------------------------------------------------------------------------
# Saleor app token with MANAGE_ORDERS is also needed to read order status and
# show recent orders; do not reuse the public storefront credential.
# SALEOR_APP_TOKEN=
# Dashboard origin for 'Edit product', 'Ship / View order' admin links.
# SALEOR_DASHBOARD_URL=https://admin.example.com
# Resend transactional email account and verified sender domain.
# RESEND_API_KEY=
# PAYMENT_REMINDER_FROM=Orders <orders@example.com>
# Secret used by your self-hosted hourly cron in addition to the /ops Basic auth.
# PAYMENT_REMINDER_CRON_SECRET=
# See docs/analytics-payment-reminders.md before enabling reminders.

# Storefront homepage theme builder (Puck editor at /ops/themes).
# Reuses ANALYTICS_LIBSQL_URL / ANALYTICS_LIBSQL_AUTH_TOKEN if configured.
# Optionally specify BOTH variables below for a dedicated theme libSQL database.
# One partially configured dedicated connection does not silently fall back.
# All /ops/ pages use ANALYTICS_DASHBOARD_SECRET Basic Auth; choose a long random secret.
# THEME_LIBSQL_URL=libsql://your-theme-db.turso.io
# THEME_LIBSQL_AUTH_TOKEN=
# AI-powered theme editor: persistent AES-256-GCM key (generate: openssl rand -hex 32).
# Never commit a real encryption key or an AI API token. Back up this key securely.
# THEME_AI_ENCRYPTION_KEY=
# Approved external OpenAI-compatible gateway base URLs (comma-separated, HTTPS only).
# The official https://api.openai.com/v1 is always available.
# THEME_AI_ALLOWED_ENDPOINTS=https://gateway.example.com/v1

# Stable site identity for this deployment. Must differ between independent storefronts.
# STOREFRONT_SITE_ID=primary

# ---------------------------------------------------------------------------
# Multi-brand storefront routing (foundation; NOT production multi-tenant isolation)
# ---------------------------------------------------------------------------
# Leave unset for the existing single-brand deployment. Experimental mapping:
# STOREFRONT_SITES_JSON=[{"id":"fashion","name":"Fashion","description":"Clothes for every day.","domains":["fashion.example.com","www.fashion.example.com"],"channels":["fashion-us","fashion-eu"],"defaultChannel":"fashion-us","defaultLocale":"en","logo":"/brands/fashion/logo.svg","logoInverted":"/brands/fashion/logo-white.svg","privacyPageSlug":"privacy","termsPageSlug":"terms"},{"id":"jewelry","name":"Jewelry","domains":["jewelry.example.com"],"channels":["jewelry-us"],"defaultChannel":"jewelry-us","defaultLocale":"en"}]
# Domains must match the TLS reverse proxy Host; no wildcards or shared channels.
# STOREFRONT_CHANNELS must contain the union of all brand channels, and each channel
# must be published by Saleor. CDN cache must include host. DO NOT activate in
# production until analytics/reminders, ads, checkout, feeds, SEO and account
# isolation are audited; initial work isolates only storefront routing and themes.


# ---------------------------------------------------------------------------
# Optional system-wide Chatwoot Community Edition support plugin
# ---------------------------------------------------------------------------
# No Chatwoot script or network request is made until the customer clicks the
# help button. Leave BOTH unset to disable. HTTPS is required in production.
# SUPPORT_CHATWOOT_BASE_URL=https://support.example.com
# One distinct Chatwoot Account + Website Inbox token for EVERY configured
# brand. In single-brand mode siteId is STOREFRONT_SITE_ID (default: primary).
# Website tokens are PUBLIC identifiers, not API tokens. Keep Chatwoot personal
# access tokens, agent credentials, and identity HMAC keys out of this variable.
# SUPPORT_CHATWOOT_SITES_JSON=[{"siteId":"fashion","accountId":1,"websiteToken":"public_fashion_token"},{"siteId":"jewelry","accountId":2,"websiteToken":"public_jewelry_token"}]
# See docs/customer-support.md. Phase 1 supports anonymous website chat only;
# Saleor customer/order context requires a separately authenticated integration.

# ---------------------------------------------------------------------------
# Optional brand-scoped AI Agent Bot (not Chatwoot Captain AI)
# ---------------------------------------------------------------------------
# Requires Chatwoot bindings and ANALYTICS_LIBSQL_URL / AUTH_TOKEN for dedup.
# Disabled unless SUPPORT_AI_BOTS_JSON is configured; all secrets server-only.
# Separate signing secret, bot API token and Chatwoot Inbox for every brand.
# SUPPORT_AI_BOTS_JSON=[{"siteId":"fashion","accountId":1,"inboxId":11,"webhookSecret":"REPLACE_WITH_32_PLUS_CHAR_SECRET","apiToken":"REPLACE_WITH_AGENT_BOT_API_TOKEN"}]
# Each FAQ must have an approved answer and own-brand HTTPS source URL.
# SUPPORT_AI_FAQS_JSON=[{"siteId":"fashion","id":"shipping","locale":"en","question":"What is the shipping policy?","answer":"See our published shipping policy for delivery information.","keywords":["shipping","delivery"],"sourceUrl":"https://fashion.example.com/shipping"}]
# Explicit OpenAI-compatible Chat Completions endpoint; no default model.
# SUPPORT_AI_MODEL_URL=https://api.openai.com/v1/chat/completions
# SUPPORT_AI_MODEL_NAME=your-model-id
# SUPPORT_AI_MODEL_API_KEY=
# Separate bearer key for the short-polling AI worker (minimum 32 characters).
# SUPPORT_AI_WORKER_SECRET=
# Invoke POST /api/plugins/customer-support/agent-bot-worker from a trusted background job.
# See docs/customer-support-ai.md for worker setup.
# Webhook endpoint: https://store.example.com/api/plugins/customer-support/agent-bot/fashion
# Before production: test actual Chatwoot v4.18.0 signing and bot APIs.
# See docs/customer-support-ai.md.

# System AI translation management centre (/ops/translations)
# Requires ANALYTICS_LIBSQL_URL/TOKEN or optional dedicated TRANSLATION_LIBSQL_URL/TOKEN.
# Permission-restricted Saleor service token (MANAGE_PRODUCTS, MANAGE_TRANSLATIONS).
# TRANSLATION_SALEOR_TOKEN=
# TRANSLATION_LIBSQL_URL=
# TRANSLATION_LIBSQL_AUTH_TOKEN=
# AI model provider URL must be approved HTTPS OpenAI-compatible /v1 endpoint.
# TRANSLATION_AI_BASE_URL=
# TRANSLATION_AI_API_KEY=
# TRANSLATION_AI_MODEL=
# TRANSLATION_WORKER_SECRET=GENERATE_A_SEPARATE_SECRET_OF_AT_LEAST_32_CHARACTERS
# Launch worker only after configuring: docker compose --profile translations-ai up -d
# Manual publish is disabled by default and blocked for multi-brand shared catalogs.
# TRANSLATION_PUBLISH_ENABLED=0

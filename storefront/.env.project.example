NEXT_PUBLIC_SALEOR_API_URL=http://localhost:8000/graphql/
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

NEXT_PUBLIC_DEFAULT_CHANNEL=us
STOREFRONT_CHANNELS=us

# Core launch languages for the first three market tiers + Japan.
# Currency/shipping still come from the active Saleor channel; adding a locale does not
# create a new market or payment/tax setup by itself.
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_STOREFRONT_LOCALES=en,de,fr,nl,da,sv,es,it,pl,pt,cs,ja
# Leave the hard locale↔channel matrix unset while all languages share the current market.
# When dedicated channels are created later, bind them here, e.g. ja:jp.
# NEXT_PUBLIC_STOREFRONT_LOCALE_CHANNELS=en:us,ja:jp

CONTENT_PROVIDER=saleor

ALLOW_DUMMY_PAYMENT=true
NEXT_PUBLIC_ALLOW_DUMMY_PAYMENT=true

# Enable after Stripe is configured in Saleor Dashboard:
# ENABLE_STRIPE_PAYMENTS=true
# NEXT_PUBLIC_ENABLE_STRIPE_PAYMENTS=true
# NEXT_PUBLIC_ENABLE_STRIPE_EXPRESS_CHECKOUT=true

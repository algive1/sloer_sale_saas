# ---------------------------------------------------------------------------
# Full-stack local/self-host configuration
# ---------------------------------------------------------------------------

# Database. Replace passwords before production.
POSTGRES_DB=saleor
POSTGRES_USER=saleor
POSTGRES_PASSWORD=change-me-before-production

# Saleor Core
SALEOR_SECRET_KEY=change-me-before-production-with-a-long-random-value
SALEOR_ALLOWED_HOSTS=localhost,127.0.0.1,api
SALEOR_DEFAULT_CHANNEL=us
SALEOR_DASHBOARD_URL=http://localhost:9000/
# Browser-visible Dashboard origin used for the App iframe; defaults to SALEOR_DASHBOARD_URL.
SALEOR_OPS_APP_PUBLIC_URL=http://localhost:9000/
# Saleor Core fetches the Manifest server-to-server. In local Compose, install
# http://dashboard/api/manifest from the Apps screen (not localhost:9000).
SALEOR_DEFAULT_FROM_EMAIL=noreply@example.com
SALEOR_EMAIL_URL=smtp://mailpit:1025
SALEOR_HTTP_IP_FILTER_ENABLED=False

# Production-only Saleor requirements.
# Uncomment and replace these before running scripts/deploy.sh.
# SALEOR_ALLOWED_CLIENT_HOSTS=www.example.com
# SALEOR_PUBLIC_URL=https://api.example.com/
# SALEOR_RSA_PRIVATE_KEY_FILE=.local/secrets/saleor-rsa-private-key.pem
# Production also requires SALEOR_EMAIL_URL to point to a real SMTP service.
# Upgrade preflight: bash scripts/deploy.sh --preflight-only
# External state backups (libSQL / Chatwoot / cloud media), when configured:
# RELEASE_EXTERNAL_BACKUP_RECEIPT=/absolute/private/path/receipt.json
# Readiness /ops/sites/<siteId>/readiness needs analytics storage and individual
# OPS_OPERATORS_JSON admins. Bump after remote shipping/payment/policy changes.
# OPS_READINESS_CONFIG_REVISION=1
# Mandatory for a shared-Core multi-brand deployment: refuse customer JWTs and
# global account mutations at Saleor GraphQL, not merely at the storefront UI.
# Keep false for ordinary single-brand stores with member accounts.
# SALEOR_SHARED_CORE_GUEST_ONLY=true
# Mandatory with shared-Core multi-brand guest mode: same private 32+ character
# value in Saleor API and Paper server, NEVER as NEXT_PUBLIC_ or in frontend.
# Generate: openssl rand -hex 32
# SALEOR_SHARED_CORE_CHECKOUT_GATEWAY_SECRET=replace-with-a-strong-random-secret


# Public URLs used by browser-facing builds.
# On a remote server replace localhost with your real HTTPS domains.
NEXT_PUBLIC_SALEOR_API_URL=http://localhost:8000/graphql/
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_CHECKOUT_URL=http://localhost:3000
DASHBOARD_API_URL=http://localhost:8000/graphql/
# Storefront URL used by the Dashboard development proxy and to validate the
# Commerce Ops entry. Production requests are reverse-proxied through :9000.
COMMERCE_OPS_URL=http://localhost:3000
DASHBOARD_MOUNT_URI=/
DASHBOARD_STATIC_URL=/
# Dashboard locale enum key. Saved browser preferences can be changed in the top bar.
DASHBOARD_LOCALE_CODE=ZH_HANS

# Storefront market
NEXT_PUBLIC_DEFAULT_CHANNEL=us
STOREFRONT_CHANNELS=us
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_STOREFRONT_LOCALES=en
NEXT_PUBLIC_STOREFRONT_LOCALE_CHANNELS=en:us
# Optional location-based market selection at bare '/' only. Do not configure the
# country header unless a trusted reverse proxy strips and overwrites it.
# STOREFRONT_GEO_COUNTRY_HEADER=x-storefront-visitor-country
# STOREFRONT_COUNTRY_CHANNELS=DE:eu,FR:eu,US:us
CONTENT_PROVIDER=saleor

# Local/staging checkout only. docker-compose.prod.yml forcibly disables these.
ALLOW_DUMMY_PAYMENT=true
NEXT_PUBLIC_ALLOW_DUMMY_PAYMENT=true

# Production payment example
# ENABLE_STRIPE_PAYMENTS=true
# NEXT_PUBLIC_ENABLE_STRIPE_PAYMENTS=true
# NEXT_PUBLIC_ENABLE_STRIPE_EXPRESS_CHECKOUT=true

# Storefront secrets
# REVALIDATE_SECRET=
# ORDER_VIEW_SECRET=
# SALEOR_WEBHOOK_SECRET=
# Match the secretKey on the native catalog Webhook; do not also install a duplicate forwarding subscription.
# docker-compose passes this server-only key at runtime; configure every storefront replica consistently.
# Legacy escape hatch for callers that still send ?secret=. Off by default; keep
# false and use `Authorization: Bearer <REVALIDATE_SECRET>` instead.
# REVALIDATE_ALLOW_QUERY_SECRET=false

# Storefront abuse protection
# Header the login rate limiter trusts for the client IP. Set only when a trusted
# reverse proxy strips and overwrites it, otherwise leave unset (last XFF hop).
# AUTH_RATE_LIMIT_CLIENT_IP_HEADER=cf-connecting-ip

# Optional dedicated HMAC key for the short-lived Saleor-backed Ops cookie.
# Generate at least 32 random characters (for example: openssl rand -hex 32).
# When unset, the server uses OPS_OPERATORS_JSON or ANALYTICS_DASHBOARD_SECRET.
# SALEOR_OPS_SESSION_SECRET=
# /api/og renders dynamic images and can be abused for CPU/memory pressure.
# Enable only if the storefront actually uses the OG image route.
# OG_IMAGE_API_ENABLED=true

# Analytics / advertising
# NEXT_PUBLIC_ANALYTICS_CONSENT_MODE=required
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# GA4_API_SECRET=
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-123456789
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# NEXT_PUBLIC_META_PIXEL_ID=
# META_CONVERSIONS_API_TOKEN=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# TIKTOK_EVENTS_API_ACCESS_TOKEN=
# Multi-brand server destinations (no fallback to global merchant accounts).
# Optional destination objects: ga4, meta, tiktok; each has id and secret.
# ADS_SERVER_SITES_JSON=[{"siteId":"fashion","ga4":{"id":"G-EXAMPLE","secret":"replace-server-secret"},"meta":{"id":"1234567890","secret":"replace-server-token"}}]
# Explicit trusted proxy IP header only; proxy must strip/overwrite client input.
# ANALYTICS_CLIENT_IP_HEADER=x-storefront-client-ip

# SEO / Google Merchant
# GOOGLE_MERCHANT_FEED_ENABLED=true
# GOOGLE_MERCHANT_EXCLUDE_SKU_PREFIXES=DEMO-
# Scan budget for /merchant/google.xml. Large catalogs that exceed either limit
# return 503 ("still building") instead of a truncated feed Google would reject.
# GOOGLE_MERCHANT_FEED_MAX_PAGES=200
# GOOGLE_MERCHANT_FEED_BUDGET_MS=60000

# First-party analytics / cloud wishlist (optional)
# ANALYTICS_LIBSQL_URL=
# ANALYTICS_LIBSQL_AUTH_TOKEN=
# ANALYTICS_DASHBOARD_SECRET=
# Shared system theme plugin (dedicated DB optional; otherwise analytics libSQL).
# THEME_LIBSQL_URL=
# THEME_LIBSQL_AUTH_TOKEN=
# AI-powered theme editor: persistent AES-256-GCM key (generate: openssl rand -hex 32).
# Never commit a real encryption key or an AI API token. Back up this key securely.
# THEME_AI_ENCRYPTION_KEY=
# Approved external OpenAI-compatible gateway base URLs (comma-separated, HTTPS only).
# The official https://api.openai.com/v1 is always available.
# THEME_AI_ALLOWED_ENDPOINTS=https://gateway.example.com/v1

# STOREFRONT_SITE_ID=primary
# Saleor app token (MANAGE_ORDERS), required for guest order lookup and ops orders.
# SALEOR_APP_TOKEN=
# Transactional order reminder mail; disabled until explicitly configured and enabled.
# RESEND_API_KEY=
# PAYMENT_REMINDER_FROM=Orders <orders@example.com>
# Multi-brand: explicit sender on an owned domain and email language per site; no global sender fallback.
# PAYMENT_REMINDER_SITES_JSON=[{"siteId":"fashion","from":"Fashion <orders@fashion.example>","locale":"en"}]
# PAYMENT_REMINDER_CRON_SECRET=
# Optional: if your reverse proxy/CDN exposes trusted geo headers, set their names here.
# Common providers (Cloudflare/Vercel/CloudFront) are auto-detected when possible.
# ANALYTICS_GEO_COUNTRY_HEADER=x-edge-country
# ANALYTICS_GEO_REGION_HEADER=x-edge-region

# Optional production object storage / email settings are passed through to Saleor
# when you add the corresponding Saleor-supported environment variables here
# and to docker-compose.prod.yml.

# Published Saleor CMS Page slugs for each legal policy. Verify both pages resolve
# at /<locale>/<channel>/pages/<slug> before exposing your live storefront.
# Unset values hide dead footer links. Do not ship without real legal policies.
# STOREFRONT_PRIVACY_PAGE_SLUG=privacy-policy
# STOREFRONT_TERMS_PAGE_SLUG=terms-of-service

# Chatwoot website chat + native operator inbox (self-hosted Chatwoot CE).
# For multiple brand sites, website and agent tokens must map 1:1 to their
# configured site IDs. Account IDs are private deployment configuration.
# SUPPORT_CHATWOOT_BASE_URL=https://support.example.com
# SUPPORT_CHATWOOT_SITES_JSON=[{"siteId":"primary","accountId":1,"websiteToken":"public_website_token_1234"}]
# Server-only privileged API token: generate in each matching Chatwoot account
# as a dedicated agent user with that Account's conversation permissions.
# Do NOT paste this token into NEXT_PUBLIC_, GitHub, theme files, or browser JS.
# SUPPORT_CHATWOOT_AGENT_TOKENS_JSON=[{"siteId":"primary","apiToken":"PLACE_REAL_SERVER_AGENT_TOKEN_HERE"}]
# SUPPORT_AI_BOTS_JSON=
# SUPPORT_AI_WORKER_SECRET=

# System AI translation management centre (/ops/translations)
# Requires ANALYTICS_LIBSQL_URL/TOKEN or optional dedicated TRANSLATION_LIBSQL_URL/TOKEN.
# Permission-restricted Saleor service token (MANAGE_PRODUCTS, MANAGE_TRANSLATIONS).
# TRANSLATION_SALEOR_TOKEN=
# TRANSLATION_LIBSQL_URL=
# TRANSLATION_LIBSQL_AUTH_TOKEN=
# AI model provider URL must be approved HTTPS OpenAI-compatible /v1 endpoint.
# TRANSLATION_AI_BASE_URL=
# TRANSLATION_AI_API_KEY=
# TRANSLATION_AI_MODEL=
# TRANSLATION_WORKER_SECRET=GENERATE_A_SEPARATE_SECRET_OF_AT_LEAST_32_CHARACTERS
# Launch worker only after configuring: docker compose --profile translations-ai up -d
# Manual publish is disabled by default and blocked for multi-brand shared catalogs.
# TRANSLATION_PUBLISH_ENABLED=0

# Optional separate server credential for catalog publishing checks (MANAGE_PRODUCTS).
# Never expose through NEXT_PUBLIC_*; absent uses existing SALEOR_APP_TOKEN.
OPS_CATALOG_SALEOR_TOKEN=
# Server only; native MANAGE_ORDERS. Prefer a separate credential for fulfillment.
# CSV exports require individual OPS_OPERATORS_JSON admins and ANALYTICS_LIBSQL audit storage.
# Tracking writeback REQUIRES this dedicated credential (no global-token fallback),
# individual admin, writable audit and fresh preview. Native notifications are disabled.
OPS_FULFILLMENT_SALEOR_TOKEN=

# System-wide optional plugin pause. JSON array; restart ALL storefront replicas.
# Supported: theme-builder, payment-reminders, customer-support, ai-translations,
# analytics (new collection), ads-tracking (browser/server), seo-merchant (feed only).
# Invalid/unknown/duplicate values pause all seven; historical data/core checkout/SEO retained.
SYSTEM_PLUGINS_DISABLED=[]

# Optional public WhatsApp business number per configured brand. Digits only,
# international country code, 8-15 digits; no +/spaces/provider tokens.
# Omitted brands have no WhatsApp link; numbers cannot be shared across brands.
# SUPPORT_WHATSAPP_SITES_JSON=[{"siteId":"fashion","phone":"12025550101"},{"siteId":"jewelry","phone":"12025550102"}]
# Customer-support pause disables both launchers. Configure at runtime only.

# Optional official base-image mirror overrides. Keep the reviewed digests.
# Dockerfiles default to Docker Hub; Public ECR can be used when Docker Hub is unreachable.
# NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
# NGINX_IMAGE=public.ecr.aws/docker/library/nginx:stable-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94

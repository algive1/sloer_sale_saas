{
  "name": "sloer-sale-saas",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "bootstrap:backend": "bash scripts/bootstrap-local.sh",
    "bootstrap:storefront": "bash scripts/bootstrap-storefront.sh",
    "dev:storefront": "pnpm --dir storefront dev",
    "build:storefront": "pnpm --dir storefront build",
    "test:storefront": "pnpm --dir storefront test:run",
    "stack:build": "docker compose build",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f --tail=200",
    "stack:migrate": "docker compose run --rm migrate",
    "stack:createsuperuser": "docker compose run --rm api python3 manage.py createsuperuser",
    "deploy:selfhost": "bash scripts/deploy.sh",
    "verify:paper-pin": "bash scripts/verify-paper-pin.sh",
    "config:validate": "pnpm dlx @saleor/configurator@3.23.2 validate --config config/saleor/us-baseline.yml",
    "config:diff": "pnpm dlx @saleor/configurator@3.23.2 diff --url \"$SALEOR_URL\" --token \"$SALEOR_TOKEN\" --config config/saleor/us-baseline.yml",
    "config:deploy": "pnpm dlx @saleor/configurator@3.23.2 deploy --url \"$SALEOR_URL\" --token \"$SALEOR_TOKEN\" --config config/saleor/us-baseline.yml"
  }
}
